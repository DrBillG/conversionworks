---
import { getCollection } from 'astro:content';

const directories = await getCollection('directories');
---

<footer class="border-t border-slate-200 bg-slate-50 mt-16">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <div class="col-span-1">
        <a href="/" class="text-lg font-bold text-slate-900">conversionworks<span class="text-blue-600">.site</span></a>
        <p class="mt-2 text-sm text-slate-500">Directory of the best marketing and conversion optimization tools, updated for 2026.</p>
      </div>
      <div class="col-span-1">
        <h3 class="text-sm font-semibold text-slate-700 mb-3">Directories</h3>
        <ul class="space-y-2 text-sm text-slate-500">
          {directories.map((entry) => (
            <li><a href={`/best/${entry.id}/`} class="hover:text-blue-600">{entry.data.category || entry.data.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="col-span-1">
        <h3 class="text-sm font-semibold text-slate-700 mb-3">Site</h3>
        <ul class="space-y-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-blue-600">Home</a></li>
          <li><a href="/privacy-policy/" class="hover:text-blue-600">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-slate-200 text-sm text-slate-400">
      <p>&copy; 2026 conversionworks.site. All rights reserved.</p>
    </div>
  </div>
</footer>
