---
interface RelatedPage {
  title: string;
  url: string;
  description?: string;
}
interface Props {
  pages: RelatedPage[];
}
const { pages } = Astro.props;
---

<div class="bg-slate-50 rounded-lg p-6 mt-12">
  <h2 class="text-xl font-bold text-slate-900 mb-4">Related Directory Pages</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {pages.map((page) => (
      <a href={page.url} class="block bg-white border border-slate-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-sm transition-all">
        <h3 class="font-semibold text-blue-600 hover:underline">{page.title}</h3>
        {page.description && <p class="mt-1 text-sm text-slate-500">{page.description}</p>}
      </a>
    ))}
  </div>
</div>
