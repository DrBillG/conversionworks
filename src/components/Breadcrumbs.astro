---
interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-4 py-3">
  <ol class="flex items-center flex-wrap gap-1 text-sm text-slate-500">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i < items.length - 1 ? (
          <>
            <a href={item.url} class="hover:text-blue-600">{item.name}</a>
            <span class="text-slate-300">/</span>
          </>
        ) : (
          <span class="text-slate-700 font-medium">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: new URL(item.url, Astro.site).href,
  }))
})} />
